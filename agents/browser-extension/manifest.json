{
  "manifest_version": 3,
  "name": "Laptop Monitoring - Browsegeschiedenis",
  "version": "1.0.0",
  "description": "Stuurt bezochte pagina's (ook in incognito) naar je eigen Laptop Monitoring dashboard.",
  "incognito": "spanning",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Laptop Monitoring instellingen"
  }
}
